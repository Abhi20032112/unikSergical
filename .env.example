# SMTP Configuration for Contact Form
# Replace these with your actual SMTP credentials

# SMTP Server Host (e.g., smtp.gmail.com, smtp.office365.com)
SMTP_HOST=smtp.yourdomain.com

# SMTP Port (587 for TLS, 465 for SSL, 25 for non-secure)
SMTP_PORT=587

# SMTP Username (usually your email address)
SMTP_USER=info@uniksurgical.com

# SMTP Password (app password for Gmail, regular password for others)
SMTP_PASS=your_smtp_password_here
